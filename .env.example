# ===== LLM 后端 =====
# openai | ollama（代码不出内网请用 ollama，见 PRD §6.4）
LLM_BACKEND=openai
MODEL_NAME=gpt-4o-mini

# OpenAI 模式
OPENAI_API_KEY=
# 兼容端点填到 /v1 级别即可（SDK 自动拼接 /chat/completions）：
#   端点 https://api.example.com/v1/chat/completions  →  OPENAI_BASE_URL=https://api.example.com/v1
# 误填完整后缀会自动纠正；网关不支持 json_schema 时自动降级为 prompt 约定 JSON
OPENAI_BASE_URL=

# Ollama 模式
OLLAMA_BASE_URL=http://localhost:11434

# ===== Embedding（中文友好，禁止默认 MiniLM，见 PRD §5.3）=====
# local（默认）：sentence-transformers 本地推理，源码不出机器，需 uv sync --extra embed
# ollama：需 ollama serve；openai：网关提供 embedding 模型时用；hash：仅离线测试
EMBEDDING_BACKEND=local
EMBEDDING_MODEL=BAAI/bge-base-zh-v1.5
# BGE-zh 非对称检索指令，只加 query 侧；换 bge-m3 等无需指令的模型时置空
EMBEDDING_QUERY_PREFIX=为这个句子生成表示以用于检索相关文章：

# ===== 审查参数 =====
TOKEN_BUDGET=100000
CHUNK_TOKEN_LIMIT=3000
RETRIEVAL_TOP_K=3
# 检索过滤 = top1 门限（这次检索有没有指向）+ margin 裁尾（附带几条）
# 0.45/0.05 是「条款带违规示例 + local bge-base-zh-v1.5」的标定值
# 换 embedding 模型或改规范文档都要重标定：跑 scripts/bench_rag_embeddings.py
# hash 降级模式分数口径完全不同（实测 top1 均分 0.286），必须另标定
RETRIEVAL_SCORE_THRESHOLD=0.45
RETRIEVAL_MARGIN=0.05
REVIEW_MAX_RETRIES=2
CACHE_TTL_HOURS=24

# ===== 服务 =====
HOST=0.0.0.0
PORT=8000
# 鉴权（fail-closed）：留空时 /review 一律返回 503，而不是当公开服务跑
# 报告里含源码片段，裸奔 = 源码外泄通道。生产用 `openssl rand -hex 32` 生成
API_TOKEN=
# local 模式允许读取的仓库根目录（逗号分隔）；留空 = 禁用 local 模式，
# 否则任何调用方都能让服务器读取磁盘上任意 git 仓库
ALLOWED_REPO_ROOTS=
# 任务态与结果缓存（SQLite，多 worker 共享；PRD §6.1/§6.5）
DB_PATH=.data/reviews.sqlite3
